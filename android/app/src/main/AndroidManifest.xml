    <application
        android:icon="@drawable/legacy_trilogy_icon"
        android:label="Legacy Trilogy"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".LegacyTrilogyActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    
        <!-- Motor independiente de Legacy of Goku I -->
        <meta-data android:name="gbarecomp.title"
            android:value="Legacy of Goku I Thor"/>
        <meta-data android:name="gbarecomp.rom_label"
            android:value="Dragon Ball Z: The Legacy of Goku (Europa ALGP)"/>
        <meta-data android:name="gbarecomp.rom_sha1"
            android:value="c2691355247b03083578071d4d4a017f5599be20"/>
        <meta-data android:name="gbarecomp.rom_size"
            android:value="8388608"/>
        <meta-data android:name="gbarecomp.rom_file"
            android:value="legacy1-europe.gba"/>
        <meta-data android:name="gbarecomp.bios_required"
            android:value="true"/>
        <meta-data android:name="gbarecomp.bios_sha1"
            android:value="300c20df6731a33952ded8c436f7f186d25d3492"/>
        <meta-data android:name="gbarecomp.orientation"
            android:value="landscape"/>
        <meta-data android:name="gbarecomp.payload_version"
            android:value="legacy1-trilogy-algp-1"/>
        <meta-data android:name="gbarecomp.setup_note"
            android:value="Legacy Trilogy"/>
        <meta-data android:name="gbarecomp.gyro"
            android:value="false"/>

        <activity
            android:name="org.gbarecomp.GbaGameActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/GbaTheme"
            android:screenOrientation="landscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density"/>

    
